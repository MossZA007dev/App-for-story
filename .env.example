# Saga Forge - Environment Configuration
# สามารถกำหนดตรงนี้ หรือเข้าไปใส่ผ่านหน้าจอ Settings (http://localhost:3000/settings) ได้โดยตรง

# Anthropic Claude API Key (สำหรับสร้างเนื้อเรื่องและตรวจสอบ Continuity)
ANTHROPIC_API_KEY=

# Image Generation API Key (OpenAI / Replicate / Stability)
IMAGE_API_KEY=

# Image Provider: openai, replicate, stability, หรือ mock (สำหรับทดสอบโดยไม่เสียเครดิต)
IMAGE_PROVIDER=openai

# Cloud account/database configuration (enter real values only in .env.local)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_locally
DATABASE_URL=postgresql://postgres.your-project:replace_locally@your-region.pooler.supabase.com:6543/postgres
NEXT_PUBLIC_SITE_URL=http://localhost:3004
SETTINGS_ENCRYPTION_KEY=replace_with_32_random_bytes_in_base64
# Production uses SUPABASE_CA_CERT; local development reads .supabase-ca.crt.
