# Saga Forge - Environment Configuration
# สามารถกำหนดตรงนี้ หรือเข้าไปใส่ผ่านหน้าจอ Settings (http://localhost:3000/settings) ได้โดยตรง

# Anthropic Claude API Key (สำหรับสร้างเนื้อเรื่องและตรวจสอบ Continuity)
ANTHROPIC_API_KEY=

# Image Generation API Key (OpenAI / Replicate / Stability)
IMAGE_API_KEY=

# Image Provider: openai, replicate, stability, หรือ mock (สำหรับทดสอบโดยไม่เสียเครดิต)
IMAGE_PROVIDER=openai
